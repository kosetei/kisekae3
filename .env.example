COMFYUI_URL=http://127.0.0.1:8188

# スリープまでの推定（任意。README 参照）
# PC_SLEEP_IDLE_MINUTES=60
# KEEP_AWAKE_WINDOW_MINUTES=5

# PC のスリープ状態の取得・延長（任意。README 参照）
# PC_SLEEP_SCRIPT=C:/Users/tatei/comfy-control/comfy-sleep.ps1
# PC_SLEEP_SSH_TIMEOUT_MS=6000
# PC_SLEEP_CACHE_MS=5000
# PC_SLEEP_MAX_EXTEND_MINUTES=1440

# ComfyUI のオンデマンド起動（任意。README 参照）
# COMFYUI_START_TASK=start_comfy
# COMFYUI_SSH_USER=tatei
# COMFYUI_KEEP_AWAKE_TASK=keep_awake
# AUTO_START=0
# COMFYUI_WAKE_TIMEOUT_MS=180000
# COMFYUI_START_TIMEOUT_MS=180000
# COMFYUI_ESTIMATE_WAKE_SEC=60
# COMFYUI_ESTIMATE_START_SEC=75
# COMFYUI_VRAM_GUARD_MB=
